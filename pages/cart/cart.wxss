.page { padding-bottom: 20rpx; }

/* ---------- 顶部提示 ---------- */
.ship-tip {
  display: flex;
  align-items: center;
  background: #e8f6f0;
  color: #0d7d5b;
  font-size: 24rpx;
  padding: 18rpx 24rpx;
}
.ship-ico { margin-right: 10rpx; }
.hl { font-weight: 600; }

.rx-bar {
  display: flex;
  align-items: flex-start;
  background: #fff8f1;
  color: #8a6a52;
  font-size: 22rpx;
  padding: 16rpx 24rpx;
  line-height: 1.6;
}
.rx-bar-txt { margin-left: 10rpx; flex: 1; }

/* ---------- 勾选框 ---------- */
.check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #cfd6dc;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.check.on { background: #12996f; border-color: #12996f; }
.check-ico { color: #fff; font-size: 24rpx; line-height: 1; }

/* ---------- 购物车条目 ---------- */
.c-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx 24rpx 24rpx;
  position: relative;
}
.c-item + .c-item { border-top: 1rpx solid #f2f4f5; }
.c-thumb {
  width: 150rpx;
  height: 150rpx;
  margin-left: 18rpx;
  flex-shrink: 0;
}
.c-body { flex: 1; margin-left: 18rpx; min-width: 0; }
.c-name {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.4;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.c-spec { font-size: 22rpx; color: #9aa3ab; margin-top: 6rpx; }
.c-rx {
  display: inline-block;
  font-size: 20rpx;
  color: #c2410c;
  background: #fff1e6;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  margin-top: 8rpx;
}
.c-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.c-del {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  color: #c2c8ce;
  font-size: 24rpx;
}

/* ---------- 数量步进器 ---------- */
.stepper {
  display: flex;
  align-items: center;
  border: 1rpx solid #e6eaed;
  border-radius: 8rpx;
  overflow: hidden;
}
.step-btn {
  width: 48rpx;
  height: 44rpx;
  line-height: 42rpx;
  text-align: center;
  font-size: 26rpx;
  color: #5c6670;
  background: #f7f9fa;
}
.step-num {
  width: 64rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 24rpx;
}

/* ---------- 结算栏 ---------- */
.bottom-holder { height: 140rpx; }
.all { display: flex; align-items: center; padding-right: 16rpx; }
.all-txt { font-size: 24rpx; color: #5c6670; margin-left: 10rpx; }
.sum { flex: 1; text-align: right; padding-right: 20rpx; }
.sum-line { display: flex; align-items: baseline; justify-content: flex-end; }
.sum-label { font-size: 24rpx; color: #5c6670; margin-right: 6rpx; }
.sum-sub { font-size: 20rpx; color: #9aa3ab; margin-top: 2rpx; }
.pay-btn {
  width: 220rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
}
