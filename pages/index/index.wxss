.page {
  padding-bottom: 40rpx;
}

/* ---------- 搜索栏 ---------- */
.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: linear-gradient(180deg, #12996f 0%, #12996f 55%, rgba(18, 153, 111, 0) 100%);
  position: sticky;
  top: 0;
  z-index: 10;
}
.search-box {
  flex: 1;
  height: 68rpx;
  background: #fff;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
.s-ico { font-size: 26rpx; margin-right: 10rpx; }
.s-input { flex: 1; font-size: 26rpx; }
.s-ph { color: #b6bdc4; }
.s-clear { font-size: 22rpx; color: #b6bdc4; padding: 0 6rpx; }
.s-cart {
  width: 64rpx;
  height: 64rpx;
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.s-cart-ico { font-size: 38rpx; }
.s-badge {
  position: absolute;
  top: -2rpx;
  right: -4rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  background: #e34d59;
  color: #fff;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 15rpx;
}

/* ---------- 分类 ---------- */
.cats {
  display: flex;
  white-space: nowrap;
  padding: 8rpx 20rpx 16rpx;
  background: #12996f;
}
.cat {
  flex-shrink: 0;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.82);
  padding: 10rpx 22rpx;
  margin-right: 12rpx;
  border-radius: 26rpx;
}
.cat.on {
  background: #fff;
  color: #12996f;
  font-weight: 600;
}

/* ---------- 活动位 ---------- */
.banners {
  display: flex;
  white-space: nowrap;
  padding: 20rpx 20rpx 4rpx;
}
.banner {
  flex-shrink: 0;
  width: 520rpx;
  height: 170rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #fff;
  box-sizing: border-box;
}
.banner-title { font-size: 30rpx; font-weight: 600; }
.banner-sub { font-size: 22rpx; opacity: 0.85; margin-top: 10rpx; }
.banner-emoji { font-size: 64rpx; opacity: 0.9; }

/* ---------- 保障栏 ---------- */
.promise {
  display: flex;
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 20rpx 0;
}
.promise-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.p-ico { font-size: 28rpx; }
.p-txt { font-size: 22rpx; color: #5c6670; margin-top: 6rpx; }

/* ---------- 区块标题 ---------- */
.sec-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 10rpx 28rpx 0;
}
.sec-title { font-size: 32rpx; font-weight: 600; }
.sec-count { font-size: 22rpx; color: #9aa3ab; }

/* ---------- 商品列表 ---------- */
.goods-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 16rpx 20rpx 0;
}
.goods {
  width: 345rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 16rpx;
  margin-bottom: 18rpx;
  box-sizing: border-box;
}
.goods .thumb {
  width: 313rpx;
  height: 220rpx;
}
.rx-flag {
  position: absolute;
  left: 10rpx;
  top: 10rpx;
  background: rgba(194, 65, 12, 0.92);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}
.g-name {
  font-size: 28rpx;
  font-weight: 500;
  margin-top: 16rpx;
  line-height: 1.35;
  height: 76rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.g-spec {
  font-size: 22rpx;
  color: #9aa3ab;
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.g-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}
.g-price { display: flex; align-items: baseline; }
.g-add {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #12996f;
  color: #fff;
  font-size: 32rpx;
  line-height: 46rpx;
  text-align: center;
}

/* ---------- 底部说明 ---------- */
.foot-note {
  text-align: center;
  font-size: 20rpx;
  color: #b6bdc4;
  padding: 24rpx 48rpx 0;
  line-height: 1.6;
}
