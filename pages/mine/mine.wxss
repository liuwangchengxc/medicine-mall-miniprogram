.page { padding-bottom: 60rpx; }

/* ---------- 头部 ---------- */
.hero {
  background: linear-gradient(160deg, #12996f 0%, #17ab7c 60%, #45c79c 100%);
  padding: 40rpx 28rpx 0;
  color: #fff;
}
.u-row { display: flex; align-items: center; }
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}
.avatar-ph { font-size: 48rpx; opacity: 0.85; }
.u-info { flex: 1; margin-left: 24rpx; }
.u-name { font-size: 36rpx; font-weight: 600; }
.u-sub { font-size: 22rpx; opacity: 0.85; margin-top: 8rpx; }
.u-arrow { font-size: 40rpx; opacity: 0.8; }

/* ---------- 快捷数据 ---------- */
.quick {
  display: flex;
  margin-top: 36rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 20rpx 20rpx 0 0;
  padding: 24rpx 0;
}
.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.q-num { font-size: 34rpx; font-weight: 600; }
.q-txt { font-size: 22rpx; opacity: 0.85; margin-top: 4rpx; }

/* ---------- 我的订单 ---------- */
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 8rpx;
}
.sec-title { font-size: 30rpx; font-weight: 600; }
.sec-more { font-size: 24rpx; color: #9aa3ab; }
.order-tabs {
  display: flex;
  padding: 16rpx 0 26rpx;
}
.ot-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}
.ot-ico { font-size: 44rpx; }
.ot-txt { font-size: 22rpx; color: #5c6670; margin-top: 8rpx; }
.ot-badge {
  position: absolute;
  top: -4rpx;
  right: 26rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  background: #e34d59;
  color: #fff;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
  border-radius: 14rpx;
}

/* ---------- 菜单 ---------- */
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
}
.menu-item + .menu-item { border-top: 1rpx solid #f2f4f5; }
.m-ico { font-size: 32rpx; width: 48rpx; }
.m-name { flex: 1; font-size: 28rpx; margin-left: 8rpx; }
.m-arrow { color: #c2c8ce; font-size: 34rpx; }

/* ---------- 退出 ---------- */
.logout {
  margin: 32rpx 20rpx 0;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #fff;
  border-radius: 20rpx;
  color: #e34d59;
  font-size: 28rpx;
}

/* ---------- 底部提示 ---------- */
.foot-tip {
  font-size: 20rpx;
  color: #b6bdc4;
  line-height: 1.7;
  text-align: center;
  padding: 32rpx 48rpx 0;
}
