<view class="page">

  <!-- 状态筛选 -->
  <scroll-view class="tabs" scroll-x enable-flex show-scrollbar="{{false}}">
    <view
      class="tab {{active === item.id ? 'on' : ''}}"
      wx:for="{{tabs}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTab"
    >
      {{item.name}}
      <text class="tab-dot" wx:if="{{item.id !== 'all' && counts[item.id] > 0}}">{{counts[item.id]}}</text>
    </view>
  </scroll-view>

  <!-- 订单列表 -->
  <block wx:if="{{list.length > 0}}">
    <view class="card-flat order" wx:for="{{list}}" wx:key="orderNo">

      <!-- 头部 -->
      <view class="o-head">
        <text class="o-no">{{item.orderNo}}</text>
        <text class="o-status s-{{item.status}}">{{item.statusText}}</text>
      </view>

      <!-- 商品 -->
      <view class="o-item" wx:for="{{item.items}}" wx:for-item="g" wx:key="id"
            data-id="{{g.id}}" bindtap="goDetail">
        <view class="thumb o-thumb" style="background:{{g.color}}">
          <text class="thumb-emoji">{{g.emoji}}</text>
        </view>
        <view class="o-body">
          <view class="o-name">{{g.name}}</view>
          <view class="o-spec">{{g.spec}}</view>
          <view class="o-rx" wx:if="{{g.rx}}">处方药</view>
        </view>
        <view class="o-right">
          <view class="o-price">¥{{g.price}}</view>
          <view class="o-count">×{{g.count}}</view>
        </view>
      </view>

      <!-- 金额 -->
      <view class="o-sum">
        <text class="o-time">{{item.createTimeText}}</text>
        <view class="o-total">
          共 {{item.totalCount}} 件，实付
          <text class="price"><text class="symbol">¥</text><text class="num">{{item.total}}</text></text>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="o-actions">
        <block wx:if="{{item.status === 'unpaid'}}">
          <view class="o-btn" data-no="{{item.orderNo}}" bindtap="cancel">取消订单</view>
          <view class="o-btn o-btn-primary" data-no="{{item.orderNo}}" bindtap="pay">去支付</view>
        </block>
        <block wx:elif="{{item.status === 'undelivered'}}">
          <view class="o-btn" data-no="{{item.orderNo}}" bindtap="remind">提醒发货</view>
          <view class="o-btn o-btn-primary" data-no="{{item.orderNo}}" bindtap="ship">模拟发货</view>
        </block>
        <block wx:elif="{{item.status === 'shipping'}}">
          <view class="o-btn" data-no="{{item.orderNo}}" bindtap="buyAgain">再次购买</view>
          <view class="o-btn o-btn-primary" data-no="{{item.orderNo}}" bindtap="receive">确认收货</view>
        </block>
        <block wx:elif="{{item.status === 'done'}}">
          <view class="o-btn" data-no="{{item.orderNo}}" bindtap="buyAgain">再次购买</view>
        </block>
        <block wx:else>
          <view class="o-btn" data-no="{{item.orderNo}}" bindtap="buyAgain">重新下单</view>
        </block>
      </view>
    </view>
  </block>

  <!-- 空状态 -->
  <view class="empty" wx:else>
    <view class="ico">📦</view>
    <view class="txt">
      {{active === 'all' ? '还没有订单，去挑点家庭常备药吧' : '该状态下暂无订单'}}
    </view>
    <view class="btn btn-primary" bindtap="goIndex">去逛逛</view>
  </view>

</view>
